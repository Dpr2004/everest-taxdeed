# Copie este arquivo para .env e preencha os valores reais
# NAO commite .env no git

# Banco de dados (SQLite por padrao - migra p/ Postgres depois)
DB_PATH=/app/data/taxdeed.db

# Planilha Excel que recebe os lotes
SPREADSHEET_PATH=/app/data/Planilha_Padrao_11Condados_Everest.xlsx

# Pasta de outputs (PDFs, CSVs)
OUTPUT_DIR=/app/data/outputs

# Pasta de logs
LOG_DIR=/app/logs

# Condado piloto (MVP comeca aqui - depois expande)
CONDADO_PILOTO=LEE

# Scraping config
HTTP_TIMEOUT_SEC=30
HTTP_RETRIES=3
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Alerta email (opcional — para envio direto via SMTP em vez de Gmail MCP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=dpr2004@hotmail.com
ALERT_EMAIL_FROM=

# Slack (opcional)
SLACK_WEBHOOK_URL=

# Supabase (futuro - para migrar de SQLite)
SUPABASE_URL=
SUPABASE_KEY=

# Logging
LOG_LEVEL=INFO
